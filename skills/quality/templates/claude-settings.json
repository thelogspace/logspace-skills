{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    },
    "logspace": {
      "source": { "source": "github", "repo": "thelogspace/logspace-skills" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "superpowers@claude-plugins-official": true,
    "logspace@logspace": true
  },
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./obj/**)",
      "Read(./UserSettings/**)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/Pods/**)",
      "Read(**/coverage/**)",
      "Read(**/playwright-report/**)",
      "Read(**/test-results/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
